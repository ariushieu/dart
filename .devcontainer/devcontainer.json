// Tên file: .devcontainer/devcontainer.json
{
  "name": "Dart Development Environment", 

  // CHUYỂN SANG IMAGE CHÍNH THỨC NODE/TYPESCRIPT (ổn định hơn Universal Image)
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20", 
  
  // XÓA PHẦN "features" ĐANG GÂY LỖI TRUY CẬP
  // "features": { ... }

  // CÀI ĐẶT DART SDK THỦ CÔNG QUA LỆNH (Best Practice thay thế)
  // Lệnh này cài đặt Dart từ kho apt của Ubuntu/Debian
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y dart",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code"
        // Chỉ cần Dart-Code, vì bạn đang làm bài tập Console
      ]
    }
  },

  "remoteUser": "vscode"
}
