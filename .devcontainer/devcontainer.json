// .devcontainer/devcontainer.json

{
  // SỬ DỤNG IMAGE ĐÃ CÓ SẴN DART/FLUTTER
  // Image này đã được cấu hình để chứa sẵn Dart SDK.
  "image": "mcr.microsoft.com/devcontainers/flutter", 

  // Tự động cài đặt các extension cần thiết
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code", 
        "Dart-Code.flutter"
      ]
    }
  },

  // (Tùy chọn) Chạy lệnh tải gói sau khi khởi động
  "postCreateCommand": "dart pub get" 
}